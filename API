		if part:FindFirstChild("Head") then
			local chams = Instance.new("CylinderHandleAdornment")
			chams.CFrame = CFrame.Angles(math.rad(90), 0, 0)
			chams.Transparency = 0
			chams.Height = part.Head.Size.X * 0.7
			chams.Radius = part.Head.Size.Y / 1.5
			chams.ZIndex = 2
			chams.AlwaysOnTop = false
			chams.Color3 = espColors.ChamsVis
			chams.Adornee = part.Head
			chams.AdornCullingMode = Enum.AdornCullingMode.Never
			chams.Name = "Chams"
			chams.Parent = part.Head
			cache.Chams[part] = {chams}

			local chams = Instance.new("CylinderHandleAdornment")
			chams.CFrame = CFrame.Angles(math.rad(90), 0, 0)
			chams.Transparency = 0.5
			chams.Height = part.Head.Size.X * 0.6
			chams.Radius = part.Head.Size.Y / 1.75
			chams.ZIndex = 2
			chams.AlwaysOnTop = true
			chams.Color3 = espColors.Chams
			chams.Adornee = part.Head
			chams.AdornCullingMode = Enum.AdornCullingMode.Never
			chams.Name = "Chams"
			chams.Parent = part.Head
			cache.Chams[part] = {chams}
		end
		
		if part.Name == "Head" then
			local chams = Instance.new("CylinderHandleAdornment")
			chams.CFrame = CFrame.Angles(math.rad(90), 0, 0)
			chams.Transparency = 0
			chams.Height = part.Head.Size.X * 0.7
			chams.Radius = part.Head.Size.Y / 1.5
			chams.ZIndex = 2
			chams.AlwaysOnTop = false
			chams.Color3 = espColors.ChamsVis
			chams.Adornee = part.Head
			chams.AdornCullingMode = Enum.AdornCullingMode.Never
			chams.Name = "Chams"
			chams.Parent = part.Head
			cache.Chams[part] = {chams}

			local chams = Instance.new("CylinderHandleAdornment")
			chams.CFrame = CFrame.Angles(math.rad(90), 0, 0)
			chams.Transparency = 0.5
			chams.Height = part.Head.Size.X * 0.6
			chams.Radius = part.Head.Size.Y / 1.75
			chams.ZIndex = 2
			chams.AlwaysOnTop = true
			chams.Color3 = espColors.Chams
			chams.Adornee = part.Head
			chams.AdornCullingMode = Enum.AdornCullingMode.Never
			chams.Name = "Chams"
			chams.Parent = part.Head
			cache.Chams[part] = {chams}
		end
		
		if part:IsA("Model") then
			local chamsList = {}
			
			for i, p in pairs(part:GetChildren()) do
				if not checkValidPart(p) then continue end
				local chams = Instance.new("BoxHandleAdornment")
				chams.Transparency = 0.5
				chams.Size = p.Size * 1.02
				chams.ZIndex = 2
				chams.AlwaysOnTop = true
				chams.Color3 = espColors.Chams
				chams.Adornee = p
				chams.AdornCullingMode = Enum.AdornCullingMode.Never
				chams.Name = "Chams"
				chams.Parent = p
				table.insert(chamsList, chams)

				local chams = Instance.new("BoxHandleAdornment")
				chams.Transparency = 0
				chams.Size = p.Size * 1.1
				chams.ZIndex = 2
				chams.AlwaysOnTop = false
				chams.Color3 = espColors.ChamsVis
				chams.Adornee = p
				chams.AdornCullingMode = Enum.AdornCullingMode.Never
				chams.Name = "Chams"
				chams.Parent = p
				table.insert(chamsList, chams)
			end
			
			cache.Chams[part] = chamsList
		end
	end
