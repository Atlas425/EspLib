local function isOnScreenAndInDistance(rootPos)
    local screenPos, onScreen = camera:WorldToViewportPoint(rootPos)
    local distance = (camera.CFrame.Position - rootPos).Magnitude
    return onScreen and distance <= espSettings.MaxDistance, screenPos
end

local function updateSkeleton(model)
    if not espSettings.Skeleton then
        if cache.Skeletons[model] then
            for _, l in ipairs(cache.Skeletons[model]) do l.Visible = false end
        end
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local rigType = humanoid.RigType

    cache.Skeletons[model] = cache.Skeletons[model] or {}
    for _, line in ipairs(cache.Skeletons[model]) do line:Remove() end
    cache.Skeletons[model] = {}

    local function drawLine(fromWorld, toWorld)
        local from2D, visA = camera:WorldToViewportPoint(fromWorld)
        local to2D, visB = camera:WorldToViewportPoint(toWorld)
        local line = createLine()
        if visA and visB then
            line.From = Vector2.new(from2D.X, from2D.Y)
            line.To = Vector2.new(to2D.X, to2D.Y)
            line.Color = espColors.Skeleton
            line.Visible = true
        end
        table.insert(cache.Skeletons[model], line)
    end

    if rigType == Enum.HumanoidRigType.R15 then
        local bones = {
            {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
            {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
            {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
            {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
            {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
        }

        for _, pair in ipairs(bones) do
            local a, b = model:FindFirstChild(pair[1]), model:FindFirstChild(pair[2])
            local line = createLine()
            if a and b then
                local a2D, visA = camera:WorldToViewportPoint(a.Position)
                local b2D, visB = camera:WorldToViewportPoint(b.Position)
                if visA and visB then
                    line.From = Vector2.new(a2D.X, a2D.Y)
                    line.To = Vector2.new(b2D.X, b2D.Y)
                    line.Color = espColors.Skeleton
                    line.Visible = true
                end
            end
            table.insert(cache.Skeletons[model], line)
        end

    elseif rigType == Enum.HumanoidRigType.R6 then
        local head = model:FindFirstChild("Head")
        local torso = model:FindFirstChild("Torso")
        local leftArm = model:FindFirstChild("Left Arm")
        local rightArm = model:FindFirstChild("Right Arm")
        local leftLeg = model:FindFirstChild("Left Leg")
        local rightLeg = model:FindFirstChild("Right Leg")

        if not (head and torso and leftArm and rightArm and leftLeg and rightLeg) then return end

        local torsoMid = torso.Position
        local shoulderHeight = torso.CFrame.UpVector * torso.Size.Y/2 * 0.75
        local horizontalOffset = torso.CFrame.RightVector * torso.Size.X/2 * 0.85

        local torsoTopLeft = torso.Position - horizontalOffset + shoulderHeight
        local torsoTopRight = torso.Position + horizontalOffset + shoulderHeight

        drawLine(head.Position, torso.Position)

        drawLine(torsoMid, torsoTopLeft)
        drawLine(torsoMid, torsoTopRight)

        local leftArmBottom = leftArm.Position - leftArm.CFrame.UpVector * leftArm.Size.Y / 2
        local rightArmBottom = rightArm.Position - rightArm.CFrame.UpVector * rightArm.Size.Y / 2
        local leftArmTop = leftArm.Position + leftArm.CFrame.UpVector * leftArm.Size.Y / 2 * 0.75
        local rightArmTop = rightArm.Position + rightArm.CFrame.UpVector * rightArm.Size.Y / 2 * 0.75


        drawLine(leftArmTop, leftArmBottom)
        drawLine(rightArmTop, rightArmBottom)

        drawLine(leftArmTop, torsoTopLeft)
        drawLine(rightArmTop, torsoTopRight)

        local leftLegTop = leftLeg.Position + leftLeg.CFrame.UpVector * leftLeg.Size.Y/2
        local rightLegTop = rightLeg.Position + rightLeg.CFrame.UpVector * rightLeg.Size.Y/2
        local leftLegBottom = leftLeg.Position - leftLeg.CFrame.UpVector * leftLeg.Size.Y/2
        local rightLegBottom = rightLeg.Position - rightLeg.CFrame.UpVector * rightLeg.Size.Y/2

        drawLine(torsoMid, leftLegTop)
        drawLine(torsoMid, rightLegTop)
        drawLine(leftLegTop, leftLegBottom)
        drawLine(rightLegTop, rightLegBottom)
    end
end

local function updateCornerBoxes(model, topVec, bottomVec, boxCenter, boxWidth, boxHeight)
    if not espSettings.CornerBoxes then
        if cache.CornerBoxes[model] then
            for _, l in ipairs(cache.CornerBoxes[model]) do l.Visible = false end
        end
        return
    end

    local topLeft = Vector2.new(boxCenter.X - boxWidth/2, topVec.Y)
    local topRight = Vector2.new(boxCenter.X + boxWidth/2, topVec.Y)
    local bottomLeft = Vector2.new(boxCenter.X - boxWidth/2, bottomVec.Y)
    local bottomRight = Vector2.new(boxCenter.X + boxWidth/2, bottomVec.Y)

    local minSide = math.min(boxWidth, boxHeight)
    local lineLength = math.clamp(minSide * 0.2, 2, math.max(2, minSide * 0.45))
    local thickness = math.clamp(boxWidth / 100, 1, 2)

    local box = cache.CornerBoxes[model]
    if not box then return end

    local positions = {
        {topLeft, topLeft + Vector2.new(lineLength, 0)},
        {topLeft, topLeft + Vector2.new(0, lineLength)},
        {topRight, topRight - Vector2.new(lineLength, 0)},
        {topRight, topRight + Vector2.new(0, lineLength)},
        {bottomLeft, bottomLeft + Vector2.new(lineLength, 0)},
        {bottomLeft, bottomLeft - Vector2.new(0, lineLength)},
        {bottomRight, bottomRight - Vector2.new(lineLength, 0)},
        {bottomRight, bottomRight - Vector2.new(0, lineLength)}
    }

    for i, line in ipairs(box) do
        line.From = positions[i][1]
        line.To = positions[i][2]
        line.Thickness = thickness
        line.Color = espColors.CornerBoxes
        line.Visible = true
    end
end

local function updateFillBox(model, topVec, bottomVec, boxCenter, boxWidth, boxHeight)
    if not espSettings.FillBoxes then
        if cache.FillBoxes[model] then
            cache.FillBoxes[model].Visible = false
        end
        return
    end

    local fillBox = cache.FillBoxes[model]
    if not fillBox then return end

    fillBox.Position = Vector2.new(boxCenter.X - boxWidth / 2, topVec.Y)
    fillBox.Size = Vector2.new(boxWidth, boxHeight)
    fillBox.Color = espColors.FillBoxes
    fillBox.Transparency = transparencySettings.FillBoxes
    fillBox.Visible = true
end

local function updateHealthbar(model, topVec, bottomVec, boxCenter, boxWidth, humanoid, boxHeight)
    if not espSettings.Healthbar or not model:IsDescendantOf(workspace) or not humanoid or humanoid.Health <= 0 then
        if cache.HealthBars[model] then
            if cache.HealthBars[model].Foreground then
                cache.HealthBars[model].Foreground:Remove()
            end
            if cache.HealthBars[model].Background then
                cache.HealthBars[model].Background:Remove()
            end
            cache.HealthBars[model] = nil
        end
        return
    end

    if cache.HealthBars[model] then
        if cache.HealthBars[model].Foreground and cache.HealthBars[model].Foreground.Remove then
            cache.HealthBars[model].Foreground:Remove()
        end
        if cache.HealthBars[model].Background and cache.HealthBars[model].Background.Remove then
            cache.HealthBars[model].Background:Remove()
        end
    end

    -- Create new lines
    local background = Drawing.new("Line")
    local foreground = Drawing.new("Line")

    cache.HealthBars[model] = {
        Background = background,
        Foreground = foreground
    }

    local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)

    local barHeight = bottomVec.Y - topVec.Y
    local barThickness = math.clamp(barHeight / 12.5, 1, 3)
    local outlineThickness = barThickness + 2

    local xOffset = math.clamp(boxHeight / 10, 8, 15)

    local barX = boxCenter.X - boxWidth / 2 - xOffset
    local barYTop = topVec.Y
    local barYBottom = bottomVec.Y

    background.From = Vector2.new(barX, barYTop)
    background.To = Vector2.new(barX, barYBottom)
    background.Thickness = outlineThickness
    background.Color = Color3.new(0.1, 0.1, 0.1)
    background.ZIndex = 1
    background.Visible = true

    local filledHeight = (barYBottom - barYTop) * healthRatio
    foreground.From = Vector2.new(barX, barYBottom)
    foreground.To = Vector2.new(barX, barYBottom - filledHeight)
    foreground.Thickness = barThickness
    foreground.Color = Color3.new(0, 1, 0)
    foreground.ZIndex = 2
    foreground.Visible = true
end

local function updateNametag(model, topVec, bottomVec, boxCenter)
    if not espSettings.Nametags then
        if cache.NameTags[model] then
            cache.NameTags[model].Visible = false
        end
        return
    end

    local tag = cache.NameTags[model]
    if not tag then return end

    tag.Text = customNames[model] or model.Name
    tag.Size = espSettings.TextSize
    tag.Font = espSettings.Font

    local boxHeight = bottomVec.Y - topVec.Y

    local textHeight = tag.TextBounds.Y
    local padding = 2
    local tagY = topVec.Y - textHeight

    tag.Position = Vector2.new(boxCenter.X - tag.TextBounds.X / 2, tagY)
    tag.Visible = true
    tag.Color = espColors.Nametags
end

function TrackModel(model)
    if not model:IsA("Model") then return end
    if cache.CornerBoxes[model] then return end

    cache.CornerBoxes[model] = {}
    for _ = 1, 8 do table.insert(cache.CornerBoxes[model], createLine()) end

    cache.HealthBars[model] = {
        background = createLine(),
        fill = createLine()
    }

    cache.NameTags[model] = createText()
    cache.NameTags[model].Size = espSettings.TextSize
    cache.NameTags[model].Center = false

    cache.Skeletons[model] = {}

    local fill = Drawing.new("Square")
    fill.Filled = true
    fill.Visible = false
    fill.Color = espColors.FillBoxes
    fill.Transparency = transparencySettings.FillBoxes
    cache.FillBoxes[model] = fill
end

local function updateColors()
    for model, tag in pairs(cache.NameTags) do
        if tag then
            tag.Color = espColors.Nametags or Color3.new(1, 1, 1)
            tag.Font = espSettings.Font or Drawing.Fonts.UI
        end
    end

    for model, boxLines in pairs(cache.CornerBoxes) do
        if boxLines then
            for _, line in ipairs(boxLines) do
                if line then
                    line.Color = espColors.CornerBoxes or Color3.new(1, 1, 1)
                end
            end
        end
    end

    for model, skeletonLines in pairs(cache.Skeletons) do
        if skeletonLines then
            for _, line in ipairs(skeletonLines) do
                if line then
                    line.Color = espColors.Skeleton or Color3.new(1, 1, 1)
                end
            end
        end
    end
end

