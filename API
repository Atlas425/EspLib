		cache.FillBoxes[model] = nil
	    end

            if cache.Skeletons[model] then
                for _, line in ipairs(cache.Skeletons[model]) do
                    if line.Remove then line:Remove() end
                end
                cache.Skeletons[model] = nil
            end

            if cache.HealthBars[model] then
                local bar = cache.HealthBars[model]
                if bar.background and bar.background.Remove then bar.background:Remove() end
                if bar.fill and bar.fill.Remove then bar.fill:Remove() end
                if bar.segments then
                    for _, segment in ipairs(bar.segments) do
                        if segment and segment.Remove then segment:Remove() end
                    end
                end
                cache.HealthBars[model] = nil
            end

            if cache.NameTags[model] then
                if cache.NameTags[model].Remove then
                    cache.NameTags[model]:Remove()
                end
                cache.NameTags[model] = nil
            end
        end
    end

    for model in pairs(cache.CornerBoxes) do
        local root = model:FindFirstChild("HumanoidRootPart")
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or not model:IsDescendantOf(workspace) or humanoid.Health <= 0 then
            continue
        end

        local onScreen, screenPos = isOnScreenAndInDistance(root.Position)
        if not onScreen then

            updateSkeleton(model)
            if cache.NameTags[model] then cache.NameTags[model].Visible = false end
            if cache.HealthBars[model] then
                if cache.HealthBars[model].background then
                    cache.HealthBars[model].background.Visible = false
                end
                if cache.HealthBars[model].fill then
                    cache.HealthBars[model].fill.Visible = false
                end
                if cache.HealthBars[model].segments then
                    for _, segment in ipairs(cache.HealthBars[model].segments) do
                        if segment then segment.Visible = false end
                    end
                end
		if cache.FillBoxes[model] then
	   	    cache.FillBoxes[model].Visible = false
		end
            end
            for _, l in ipairs(cache.CornerBoxes[model]) do l.Visible = false end
            continue
        end

        local cf, size = model:GetBoundingBox()
        local halfHeight = size.Y / 2
        local topVec3 = cf.Position + Vector3.new(0, halfHeight, 0)
        local bottomVec3 = cf.Position - Vector3.new(0, halfHeight, 0)

        local topVec2 = camera:WorldToViewportPoint(topVec3)
        local bottomVec2 = camera:WorldToViewportPoint(bottomVec3)

        local boxCenter = screenPos
        local scaleFactor = 1.25
	
	local originalHeight = math.abs(topVec2.Y - bottomVec2.Y)
	local centerY = (topVec2.Y + bottomVec2.Y) / 2
	local boxHeight = originalHeight * scaleFactor
	local boxWidth = (boxHeight / 2) * scaleFactor
	
	topVec2 = Vector3.new(topVec2.X, centerY - boxHeight / 2, 0)
	bottomVec2 = Vector3.new(bottomVec2.X, centerY + boxHeight / 2, 0)

        updateSkeleton(model)
        updateCornerBoxes(model, topVec2, bottomVec2, boxCenter, boxWidth, boxHeight)
	updateFillBox(model, topVec2, bottomVec2, boxCenter, boxWidth, boxHeight)
        updateHealthbar(model, topVec2, bottomVec2, boxCenter, boxWidth, humanoid, boxHeight)
        updateNametag(model, topVec2, bottomVec2, boxCenter)
        updateColors()
    end
end)

return {
    espSettings = espSettings,
    transparencySettings = transparencySettings,
    espColors = espColors,
    cache = cache,
    addDisplayBox = addDisplayBox,
    drawSnaplines = drawSnaplines,
    drawCircle = drawFOVCircle,
    createChams = createChams,
    chamsTween = chamsTween,
    removeSnapline = removeSnapline,
    createBox = createESPBox,
    removeBox = removeESPBox,
    trackModel = TrackModel,
    customNames = customNames,
    chamsExclusionList = chamsExclusionList,
}
